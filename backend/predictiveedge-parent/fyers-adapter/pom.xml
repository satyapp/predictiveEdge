<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.predictiveedge</groupId><artifactId>predictiveedge-platform-core</artifactId><version>0.1.0-SNAPSHOT</version><relativePath>../predictiveedge-platform-core</relativePath></parent>
  <artifactId>fyers-adapter</artifactId>
  <name>PredictiveEdge FYERS Adapter</name>
  <dependencies>
    <dependency><groupId>org.predictiveedge</groupId><artifactId>chart-intelligence-application</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.predictiveedge</groupId><artifactId>broker-connection-application</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.predictiveedge</groupId><artifactId>identity-application</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-autoconfigure</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <!-- Official FYERS API v3 Java SDK 2.2.0 (fat jar), see third-party/README.md. -->
    <dependency><groupId>in.fyers</groupId><artifactId>fyers-java-sdk</artifactId><version>2.2.0</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope>
      <!-- android-json also defines org.json.JSONObject and would shadow the copy the FYERS SDK needs. -->
      <exclusions><exclusion><groupId>com.vaadin.external.google</groupId><artifactId>android-json</artifactId></exclusion></exclusions></dependency>
  </dependencies>
</project>
